# FreshLoop Environment Configuration
# Team: HexaCore

# NEXT.JS ENVIRONMENT
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# SUPABASE CONFIGURATION (Remote Hosted PostgreSQL & Auth)
# If left blank or unconfigured, FreshLoop automatically runs in High-Fidelity Local Demo Mode
# with deterministic persistence, full transactional safety, and zero external network dependencies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# APPLICATION DEMO & MOCK SETTINGS
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=true
NEXT_PUBLIC_DEFAULT_LOCALE=en
